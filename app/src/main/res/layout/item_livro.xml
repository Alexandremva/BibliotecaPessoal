<?xml version="1.0" encoding="utf-8"?>
<!--
    LAYOUT DE UM ITEM DA LISTA: o "cartão" de UM livro.
    O AdapterLivro usa este arquivo para desenhar cada livro dentro da RecyclerView.

    Estrutura:
    [faixa colorida] | Título (negrito)
                     | Autor: ...
                     | Ano: ...   Nota: X/10 ........ Lido / Não lido
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/superficie"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Faixa vertical à esquerda: verde se lido, vermelha se não lido (cor definida no Adapter) -->
        <View
            android:id="@+id/viewIndicador"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@color/status_nao_lido" />

        <!-- Área de textos: layout_weight="1" faz ocupar todo o espaço restante ao lado da faixa -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_primario"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAutor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <!-- Linha inferior: Ano, Nota (ocupa o meio) e Status (encostado à direita) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvNota"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
