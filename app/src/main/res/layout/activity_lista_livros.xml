<?xml version="1.0" encoding="utf-8"?>
<!--
    LAYOUT DA TELA "MEUS LIVROS" (ListaLivrosActivity).

    Estrutura (de cima para baixo):
      1. Toolbar (barra de título azul)
      2. Área de conteúdo: dica de uso + lista rolável de livros (RecyclerView)
         ou a mensagem de "lista vazia" quando não há livros
      3. Menu inferior (BottomNavigationView)

    ConstraintLayout posiciona cada elemento por "restrições" (constraints),
    ex.: "o topo do conteúdo fica embaixo da toolbar".
    O id "main" é usado no código para aplicar o espaçamento das barras do sistema.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaria">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primaria"
        app:title="@string/titulo_lista"
        app:titleTextColor="@color/branco"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        FrameLayout empilha os filhos um sobre o outro: a lista e a mensagem de
        "lista vazia" ocupam o mesmo espaço; o código mostra/esconde a mensagem.
        Altura 0dp + constraints = ocupa todo o espaço entre a toolbar e o menu inferior.
    -->
    <FrameLayout
        android:id="@+id/conteudo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/fundo"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                android:text="@string/lista_dica"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

            <!-- Lista rolável de livros; cada item usa o layout item_livro.xml -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLivros"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <!-- Mensagem exibida só quando não há livros (começa escondida: visibility="gone") -->
        <TextView
            android:id="@+id/tvListaVazia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/lista_vazia"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Menu inferior com 3 itens (definidos em menu/menu_navegacao.xml) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_navegacao" />

</androidx.constraintlayout.widget.ConstraintLayout>
